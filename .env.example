# 아래 Kakao 키는 src/legacy와 구형 components/hooks 전용입니다.
# 새 모아 UI는 Leaflet·OpenStreetMap을 사용하므로 필수 지도 API 키가 없습니다.
VITE_KAKAO_JS_KEY=your_kakao_javascript_key_here
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 백엔드 주소 (Vercel 배포 시에만 설정. 로컬 dev는 비워두면 Vite proxy 사용)
# 예) VITE_API_BASE=https://carpool-api.duckdns.org
#     VITE_WS_BASE=wss://carpool-api.duckdns.org
VITE_API_BASE=
# 구형 화면의 WebSocket 주소입니다. 새 모아 UI는 VITE_API_BASE를 사용합니다.
VITE_WS_BASE=
